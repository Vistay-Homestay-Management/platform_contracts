{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.vistay.vn/events/v1/notification.notification-created.payload.schema.json",
  "title": "Notification created payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "notificationId",
    "recipientAccountId",
    "category",
    "templateKey",
    "channels",
    "cursor",
    "createdAt"
  ],
  "properties": {
    "notificationId": { "type": "string", "format": "uuid" },
    "recipientAccountId": { "type": "string", "format": "uuid" },
    "category": { "enum": ["WELCOME", "SECURITY"] },
    "templateKey": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$",
      "maxLength": 100
    },
    "channels": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["IN_APP", "EMAIL", "PUSH"] }
    },
    "cursor": { "type": "string", "minLength": 1, "maxLength": 512 },
    "createdAt": { "type": "string", "format": "date-time" }
  }
}
