{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.vistay.vn/events/v1/user.profile-link-requested.payload.schema.json",
  "title": "Profile link requested payload v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["accountId", "accountType", "email", "requestedAt"],
  "properties": {
    "accountId": { "type": "string", "format": "uuid" },
    "accountType": { "enum": ["CUSTOMER", "ADMIN", "HOST"] },
    "email": { "type": "string", "format": "email", "maxLength": 254 },
    "requestedAt": { "type": "string", "format": "date-time" }
  }
}
