{
  "name": "@vistay/platform-contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npm run validate:events && npm run validate:notifications && npm run validate:graphql && npm run validate:architecture && npm run validate:pricing && npm run validate:jira",
    "build:jira": "node scripts/build-jira-catalog.mjs",
    "audit:jira-readiness": "node scripts/audit-jira-readiness.mjs",
    "test:jira-readiness": "npm run build:jira && node scripts/test-jira-catalog-validation.mjs",
    "validate:schemas": "node scripts/validate-schemas.mjs",
    "validate:events": "npm run validate:schemas",
    "validate:notifications": "node scripts/validate-notification-contract-fixtures.mjs",
    "validate:graphql": "node scripts/validate-graphql.mjs",
    "validate:architecture": "node scripts/validate-architecture-artifacts.mjs",
    "validate:pricing": "node scripts/validate-pricing-publication.mjs",
